PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/macrohostel
# If mongodb+srv:// fails with querySrv ECONNREFUSED on your network, use Atlas's
# standard connection string from Connect > Drivers > "I have MongoDB Compass" style host list.
# Example:
# MONGO_URI=mongodb://USER:PASSWORD@host-00-00.mongodb.net:27017,host-00-01.mongodb.net:27017,host-00-02.mongodb.net:27017/macrotracker?ssl=true&replicaSet=YOUR_REPLICA_SET&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=5001
CLIENT_ORIGIN=*
